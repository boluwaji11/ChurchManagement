{
  "$comment": "Space, radius, elevation, motion. Density-dependent values live in density.json.",
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "20": "80px", "24": "96px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "xl": "20px", "full": "9999px" },
  "elevation": {
    "sm": "0 1px 2px oklch(0 0 0 / 0.04), 0 1px 3px oklch(0 0 0 / 0.06)",
    "md": "0 2px 4px oklch(0 0 0 / 0.04), 0 4px 12px oklch(0 0 0 / 0.08)",
    "lg": "0 4px 8px oklch(0 0 0 / 0.04), 0 12px 32px oklch(0 0 0 / 0.10)"
  },
  "motion": {
    "duration": { "instant": "80ms", "fast": "140ms", "base": "200ms", "slow": "300ms", "spring": "420ms" },
    "ease": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "in": "cubic-bezier(0.32, 0, 0.67, 0)"
    }
  },
  "type": {
    "display-lg": { "size": "2.75rem", "leading": "3rem",    "face": "display", "weight": "600", "tracking": "-0.02em" },
    "display":    { "size": "2rem",    "leading": "2.375rem","face": "display", "weight": "600", "tracking": "-0.015em" },
    "heading":    { "size": "1.375rem","leading": "1.75rem", "face": "display", "weight": "600", "tracking": "-0.01em" },
    "title":      { "size": "1.0625rem","leading": "1.5rem", "face": "sans",    "weight": "600", "tracking": "-0.005em" },
    "body-lg":    { "size": "1rem",    "leading": "1.5rem",  "face": "sans",    "weight": "400", "tracking": "0" },
    "body":       { "size": "0.875rem","leading": "1.25rem", "face": "sans",    "weight": "400", "tracking": "0" },
    "label":      { "size": "0.8125rem","leading": "1rem",   "face": "sans",    "weight": "500", "tracking": "0" },
    "caption":    { "size": "0.75rem", "leading": "1rem",    "face": "sans",    "weight": "400", "tracking": "0.005em" },
    "code":       { "size": "0.875rem","leading": "1.25rem", "face": "mono",    "weight": "500", "tracking": "0" }
  }
}
