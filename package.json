{
  "name": "connectapp",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "tokens": "pnpm --filter @connectapp/ui run tokens",
    "db:generate": "pnpm --filter @connectapp/db run generate",
    "db:migrate": "pnpm --filter @connectapp/db run migrate",
    "db:seed": "pnpm --filter @connectapp/db run seed",
    "test": "turbo run test",
    "db:seed:users": "pnpm --filter @connectapp/db run seed:users"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
