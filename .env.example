# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# Supabase project. The NEXT_PUBLIC pair is what the browser uses, and the
# publishable key is safe to expose: it is constrained by row-level security.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Passwords for the seeded test accounts. Local development only.
SEED_USER_PASSWORD=

# Both connections go through the Supabase pooler, not through
# db.<project-ref>.supabase.co. The direct host publishes an IPv6 address and no
# IPv4 one, so on a network without IPv6 it fails as ENOTFOUND, which reads like
# a typo rather than like a routing problem. The pooler is reachable either way.
#
# The region is in the hostname and the project ref is in the username. Copy both
# from the Supabase dashboard: Project Settings, Database, Connection string,
# Session pooler.

# Migrations and seeding connect as the owner role.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The application connects as a role that row-level security APPLIES to.
# Never the owner, never the service role. See docs/architecture.md.
APP_DATABASE_URL=postgresql://hearth_app.<project-ref>:<app-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Application-level encryption for confidential pastoral notes (R21.3).
# 32 bytes, base64. Generate: openssl rand -base64 32
NOTE_ENCRYPTION_KEY=

# R16.10. Web push. One pair for the deployment, not one a church.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave unset and the product runs with no push: members read the bell.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@connectapp.church

# Website support form. Authenticate with the admin mailbox's app password.
# Configure support@connectapp.church as a send-as alias for that mailbox.
SUPPORT_SMTP_USER=bolu@connectapp.church
SUPPORT_SMTP_APP_PASSWORD=
SUPPORT_FROM_EMAIL=support@connectapp.church
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# R13.1, R13.2. Giving. The platform's own Stripe key, used to create each
# church's own connected account and to read its state. It never takes a
# payment onto a platform balance: every charge is a direct charge on the
# church's account with no application fee. See docs/giving.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# R17.1. The parent every church address sits under, so one sign-in reaches all
# of them: a member signed in at connectapp.church is still signed in at
# riverside.connectapp.church. Set it to the parent, never to a host we do not
# own. Unset, the cookie stays on the host that set it.
#
# Not localhost. The Domain attribute wants a registrable name and Chrome
# refuses localhost for it, so a cookie set there never reaches
# riverside.localhost however it is written. lvh.me and everything under it
# resolve to 127.0.0.1 and are a real name, so church addresses work in
# development the way they will in production.
# In development it is left unset, so localhost behaves exactly as it always
# has. The cost is that a church's own address asks you to sign in again,
# because the cookie cannot follow it. To work on that part, add a name of
# your own to /etc/hosts, which keeps everything on your machine:
#
#   127.0.0.1  connectapp.test riverside.connectapp.test
#
# then set PLATFORM_HOST=connectapp.test and AUTH_COOKIE_DOMAIN=.connectapp.test.
# `.test` is reserved for exactly this and resolves nowhere else.
#   production  AUTH_COOKIE_DOMAIN=.connectapp.church
# AUTH_COOKIE_DOMAIN=

# R1.1. Our own host, which every church gets a name under. Read when a
# request's host has to be turned into a church.
#   production  PLATFORM_HOST=connectapp.church
#   development PLATFORM_HOST=localhost
PLATFORM_HOST=localhost

# HRT-287, R21.15. A church's own messaging credential, sealed. A separate key
# from the notes, so a leak of one is not a leak of the other.
# 32 bytes, base64. Generate: openssl rand -base64 32
PROVIDER_CREDENTIAL_KEY=

# HRT-288, R16.1. The OAuth client Resend issued us, so a church connects by
# pressing a button rather than by pasting a key. Public client, no secret.
# Register one per environment, with that environment's callback address:
#   curl -X POST https://api.resend.com/oauth/register -H "Content-Type: application/json" \
#     -d "{\"client_name\":\"ConnectApp\",\"redirect_uris\":[\"https://connectapp.church/api/providers/resend/callback\"],\"grant_types\":[\"authorization_code\",\"refresh_token\"],\"response_types\":[\"code\"],\"token_endpoint_auth_method\":\"none\",\"scope\":\"full_access\"}"
RESEND_OAUTH_CLIENT_ID=

# HRT-289, R22.2. The private half of the Domain Connect signing key, whose
# public half is published as a TXT record at _dck1 on our own domain. It signs
# the request that asks a church's DNS company to write the three sending
# records, so the company can tell our request from somebody else's. Unset and
# the one-press is simply not offered. See docs/domain-connect.
DOMAIN_CONNECT_PRIVATE_KEY=
